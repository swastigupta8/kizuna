GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# Optional locally — db.py defaults to a local file (file:kizuna.db) with no
# credentials needed. Only set these to point at a real Turso database, e.g.
# to test production persistence locally.
# DB_URL=libsql://your-database.turso.io
# DB_AUTH_TOKEN=your-turso-auth-token
